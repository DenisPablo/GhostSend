{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "your-domain.com",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_HOST;Port=5432;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "LocalStorage": {
    "BasePath": "uploads"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://your-domain.com"
    ]
  },
  "FileSettings": {
    "MaxFileSizeInBytes": 104857600,
    "MaxFileSizeDescription": "100MB"
  },
  "MinioSettings": {
    "ServiceURL": "http://localhost:9000",
    "AccessKey": "YOUR_MINIO_ACCESS_KEY",
    "SecretKey": "YOUR_MINIO_SECRET_KEY",
    "BucketName": "YOUR_MINIO_BUCKET",
    "ForcePathStyle": true
  }
}

