<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GhostSend.Application\GhostSend.Application.csproj" />
    <ProjectReference Include="..\GhostSend.Domain\GhostSend.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!--
      Override transitive System.Security.Cryptography.Xml to fix NU1903 high-severity CVE.
      This package is NOT used directly by GhostSend code. The advisory (GHSA-37gx-xxp4-5rgx,
      GHSA-w3x6-4m5h-cxqf) affects the XML signing API which we never call.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.8" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

</Project>
